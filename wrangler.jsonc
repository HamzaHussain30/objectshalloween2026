{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "objectshalloween2026",
  "compatibility_date": "2026-10-06",
  // build the static export before every deploy, so no separate build step is needed
  "build": {
    "command": "npm run build"
  },
  // static export from `next build` (output: "export")
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
